# ============================================================
# GAMEFICATION CONCURSO.OS — Environment Variables
#
# Copie este arquivo para `.env.local` e preencha com suas
# chaves reais. NUNCA comite o `.env.local` (já está no
# .gitignore).
#
# No Vercel: Project Settings → Environment Variables
# Adicione cada uma destas chaves para Production, Preview e
# Development.
# ============================================================

# ----- Supabase ---------------------------------------------
# Supabase Dashboard → Project Settings → API
# - URL: "Project URL"
# - Anon key: "anon public" (pode ser exposta ao browser)
# - Service role key: "service_role" (NUNCA exponha ao browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ----- Anthropic --------------------------------------------
# https://console.anthropic.com → Settings → API Keys
# Adicione créditos em Settings → Billing antes de usar.
ANTHROPIC_API_KEY=sk-ant-api03-...
